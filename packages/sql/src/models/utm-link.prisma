/// Tracked short link `/utm/<path>` that redirects to the storefront with fixed UTMs. `path` has 1..6
/// lowercase segments joined by "/". Managed by superAdmin only; resolved publicly by path. Global (not per company).
model UtmLink {
    id        String   @id @default(cuid())
    path      String
    source    String?
    medium    String?
    campaign  String?
    content   String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    destinations UtmLinkDestination[]

    @@unique([path])
    @@map("utm_link")
}

/// Where a link lands for one company: a unit (`unitSlug`), an arbitrary `url` (absolute http(s) or storefront
/// "/path"), or the home when the company has no row. `unitSlug` wins over `url`.
model UtmLinkDestination {
    id        String  @id @default(cuid())
    utmLinkId String
    companyId String
    unitSlug  String?
    url       String?

    utmLink UtmLink @relation(fields: [utmLinkId], references: [id], onDelete: Cascade)
    company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

    @@unique([utmLinkId, companyId])
    @@map("utm_link_destination")
}
