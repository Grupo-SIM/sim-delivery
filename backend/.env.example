ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
OWNER_EMAIL=
OWNER_NAME=
OWNER_PASSWORD=
# Optional runtime override: API_URL=http://localhost:3333
# Optional runtime override: APP_URL=http://localhost:5173
BETTER_AUTH_SECRETS=
# Optional runtime override: BETTER_AUTH_URL=${API_URL}
COMPANY_SLUG=
# Optional runtime override: CORS_WHITELIST=${APP_URL}
DATABASE_TEST_URL=postgresql://postgres:postgres@localhost:5432/example_test
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/example
# DOM acquiring credential now belongs to the SIM INT PAY Delivery profile.
MAIL_DRIVER=nodemailer
MAIL_FROM=
MAIL_HOST=
MAIL_PASS=
MAIL_PORT=
MAIL_USER=
NODE_ENV=development
# Use `whatsapp` in environments where WhatsApp OTP is enabled; `console` remains useful locally.
PHONE_OTP_DRIVER=console
PORT=3333
S3_ACCESS_KEY_ID=
S3_BUCKET=
S3_ENDPOINT=
S3_SECRET_ACCESS_KEY=
SIMPAY_API_URL=https://simpay-back.simintermediacoes.com
# Configure the same 32+ character value on back-simpay as X-Simpay-Webhook-Secret.
SIMPAY_WEBHOOK_SECRET=
STATIC_DIR=
STORAGE_DRIVER=s3
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TZ=America/Sao_Paulo
WAHA_API_KEY=
WAHA_BASE_URL=http://localhost:3000
# General session used by login OTP and as fallback for disconnected units.
# Optional runtime override (default: company slug): WAHA_SESSION=custom-session
# Set to `waha` to enqueue and deliver order-status notifications through WAHA.
WHATSAPP_DRIVER=disabled

# Canonical SIM INT PAY: service bootstrap + local credential encryption
SIMPAY_PROVISIONING_TOKEN=
SIMPAY_CREDENTIALS_ENCRYPTION_KEY=
# SIMPAY_INTERNAL_TOKEN remains a temporary bootstrap alias; webhook secret drains old callbacks.
