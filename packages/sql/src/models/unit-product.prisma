/// Associates a Product with a Unit's menu (docs/05). A product only shows in a unit's
/// menu when this row exists. Each association may override price/cashback, set which
/// category it appears under, and carry per-unit availability and stock.
model UnitProduct {
    id                      String   @id @default(cuid())
    unitId                  String
    productId               String
    /// True when category join rows override product defaults. Empty join set means explicit none.
    categoriesOverridden    Boolean  @default(false)
    /// True when tag join rows override product defaults. Empty join set means explicit none.
    tagsOverridden          Boolean  @default(false)
    /// Per-unit price override in cents; null = use the product base price.
    priceCentsOverride      Int?
    /// Temporary promotional price in cents for this unit; null = no promotion.
    promotionalPriceCents   Int?
    /// Per-unit cashback percent override; null = use the product/unit default.
    cashbackPercentOverride Float?
    /// Whether the product is currently orderable at this unit.
    available               Boolean  @default(true)
    /// Optional stock count (MVP+); null = untracked.
    stock                   Int?
    /// When set, this product is pinned to the "Os mais pedidos" strip before popularity-based items.
    /// Lower rank = earlier in the list. Null = not manually featured.
    featuredRank            Int?
    createdAt               DateTime @default(now())
    updatedAt               DateTime @updatedAt

    unit       Unit                  @relation(fields: [unitId], references: [id], onDelete: Cascade)
    product    Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
    categories UnitProductCategory[]
    additionalOptions UnitProductAdditionalOption[]
    excludedOptions UnitProductExcludedOption[]
    optionOverrides UnitProductOptionOverride[]
    tags       UnitProductTag[]

    @@unique([unitId, productId])
    @@index([unitId])
    @@index([productId])
    @@map("unit_product")
}

/// Sparse per-unit changes to a shared product option. Null fields inherit from the product option.
model UnitProductOptionOverride {
    unitProductId    String
    optionId         String
    name             String?
    description      String?
    imageUrl         String?
    priceDeltaCents  Int?
    maxPerItem       Int?
    available        Boolean?
    sortOrder        Int?
    createdAt        DateTime @default(now())
    updatedAt        DateTime @updatedAt

    option      Option      @relation(fields: [optionId], references: [id], onDelete: Cascade)
    unitProduct UnitProduct @relation(fields: [unitProductId], references: [id], onDelete: Cascade)

    @@id([unitProductId, optionId])
    @@index([optionId])
    @@map("unit_product_option_override")
}

/// An option available only in one unit, attached to an existing shared option group.
model UnitProductAdditionalOption {
    id              String   @id @default(cuid())
    unitProductId   String
    groupId         String
    name            String
    description     String   @default("")
    imageUrl        String?
    priceDeltaCents Int      @default(0)
    maxPerItem      Int?
    available       Boolean  @default(true)
    sortOrder       Int      @default(0)
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt

    group       OptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
    unitProduct UnitProduct @relation(fields: [unitProductId], references: [id], onDelete: Cascade)
    recipeIngredients LocalOptionRecipeIngredient[]

    @@index([groupId])
    @@index([unitProductId])
    @@map("unit_product_additional_option")
}

/// Hides a globally-defined option from one unit's effective product catalog.
model UnitProductExcludedOption {
    unitProductId String
    optionId      String
    createdAt     DateTime @default(now())

    option      Option      @relation(fields: [optionId], references: [id], onDelete: Cascade)
    unitProduct UnitProduct @relation(fields: [unitProductId], references: [id], onDelete: Cascade)

    @@id([unitProductId, optionId])
    @@index([optionId])
    @@map("unit_product_excluded_option")
}

model UnitProductCategory {
    unitProductId String
    categoryId    String
    createdAt     DateTime @default(now())

    unitProduct UnitProduct @relation(fields: [unitProductId], references: [id], onDelete: Cascade)
    category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)

    @@id([unitProductId, categoryId])
    @@index([categoryId])
    @@map("unit_product_category")
}

model UnitProductTag {
    unitProductId String
    tagId         String
    createdAt     DateTime @default(now())

    unitProduct UnitProduct @relation(fields: [unitProductId], references: [id], onDelete: Cascade)
    tag         Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

    @@id([unitProductId, tagId])
    @@index([tagId])
    @@map("unit_product_tag")
}
