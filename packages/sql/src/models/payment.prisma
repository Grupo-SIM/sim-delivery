/// A payment record tied to one order. Created by POST /payments/pix or /payments/card.
/// Status lifecycle: pending → confirmed | failed. A confirmed payment may later move to
/// partially_refunded | refunded via `Refund` records (see RefundPayment use case).
model Payment {
    id              String   @id @default(cuid())
    orderId         String   @unique
    /// One-time opaque token used by the storefront to poll payment status.
    token           String   @unique @default(cuid())
    /// "pending" | "confirmed" | "failed" | "partially_refunded" | "refunded"
    status          String   @default("pending")
    confirmedAt DateTime?
    /// "pix" | "credit_card"
    method          String   @default("pix")
    /// Amount in cents, mirrors order total at intent creation time.
    amount          Int
    /// Cents refunded so far across all `Refund` records; never exceeds `amount`.
    refundedAmount  Int      @default(0)
    /// Cents of the commercial share owed to coproducers, frozen by SIM INT PAY; reports deduct it from company revenue.
    coproductionCents Int    @default(0)
    /// SimIntPay fee deducted from the merchant share (SIMINTPAY_ONLY and BOTH); zero otherwise.
    simintpayFeeCents Int    @default(0)
    /// Set when the first refund completes.
    refundedAt      DateTime?
    /// DOM payment id returned by the Simpay backend; used for status polling.
    simpayPaymentId String?
    /// PIX QR code image (data URL) and copy-paste payload, present when method = "pix".
    pixQrcode       String?
    pixContent      String?
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt

    order   Order    @relation(fields: [orderId], references: [id])
    refunds Refund[]

    @@map("payment")
}

/// A single refund event against a `Payment`, supporting partial and repeated refunds.
/// The system is the accounting source of truth; actual bank settlement may still be
/// manual until the gateway exposes a refund API (see SimpayClient.refundPayment).
model Refund {
    id          String   @id @default(cuid())
    companyId   String
    orderId     String
    paymentId   String
    /// Cents refunded by this event.
    amount      Int
    reason      String?
    /// "gateway" | "manual" | "cashback"
    method      String
    /// "pending" | "completed" | "failed"
    status      String   @default("pending")
    /// Gateway-side refund id, present when method = "gateway" and it succeeds.
    externalId  String?
    /// Staff member who authorized the refund.
    userId      String?
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
    order   Order   @relation(fields: [orderId], references: [id])
    payment Payment @relation(fields: [paymentId], references: [id])
    user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

    @@index([companyId, createdAt])
    @@index([orderId])
    @@map("refund")
}

/// A tokenized credit card saved by a customer for reuse at checkout.
/// The token comes from DOM Pagamentos; the PAN is never stored.
model SavedCard {
    id          String   @id @default(cuid())
    customerId  String
    cardToken   String
    last4       String
    brand       String
    expiryMonth String
    expiryYear  String
    holderName  String
    /// CPF of the card holder, digits only. Null only for cards saved before this field existed.
    bin String?
    holderDocument String?
    nickname    String?
    isDefault   Boolean  @default(false)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

    @@index([customerId])
    @@map("saved_card")
}

/// Backend-only credentials; never included in company public DTOs.
model CompanySimpayIntegration {
    companyId String @id
    company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
    registrationId String
    platformId String?
    platformTag String?
    merchantId String?
    status String @default("PENDING_OWNER")
    encryptedAccessToken String?
    encryptedWebhookSecret String?
    /// Last provider additive revision acknowledged by Delivery; null protects existing provider configuration.
    additiveFeeRevision String?
    additiveFeeOverridden Boolean @default(false)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    @@map("company_simpay_integration")
}

model PaymentAttempt {
    id String @id @default(cuid())
    orderId String
    companyId String
    method String
    state String @default("preparing")
    amountCents Int
    merchantAmountCents Int
    platformFeeCents Int
    itemsAmountCents Int?
    deliveryAmountCents Int?
    requestHash String
    providerTransactionId String?
    providerPaymentId String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    @@index([orderId, createdAt])
    @@index([state, updatedAt])
    @@map("payment_attempt")
}

model SimpayWebhookInbox {
    id String @id @default(cuid())
    companyId String
    eventId String
    payload Json
    processedAt DateTime?
    createdAt DateTime @default(now())
    @@unique([companyId, eventId])
    @@index([processedAt, createdAt])
    @@map("simpay_webhook_inbox")
}
