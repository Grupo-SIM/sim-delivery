{
	"$schema": "https://turborepo.dev/schema.json",
	"tasks": {
		"backend#build": {
			"cache": false,
			"dependsOn": ["^export", "generate"],
			"env": ["COMPANY_SLUG", "DATABASE_URL", "NODE_ENV", "VITE_API_URL", "VITE_APP_URL", "VITE_COMPANY_SLUG"],
			"inputs": ["scripts/inject.ts", "src/**", ".env*"],
			"outputLogs": "new-only",
			"outputs": ["dist/**"]
		},
		"backend#dev": {
			"cache": false,
			"dependsOn": ["^export", "generate"],
			"env": ["COMPANY_SLUG", "DATABASE_URL", "NODE_ENV", "VITE_API_URL", "VITE_APP_URL", "VITE_COMPANY_SLUG"],
			"persistent": true
		},
		"backend#inject": {
			"cache": false,
			"dependsOn": ["sql#export"],
			"env": ["COMPANY_SLUG", "DATABASE_URL", "NODE_ENV"],
			"inputs": ["scripts/inject.ts", ".env*"],
			"outputLogs": "new-only",
			"outputs": ["src/shared/infra/branding.ts"]
		},
		"build": {
			"dependsOn": ["^export", "generate"],
			"inputs": ["src/**", "!src/**/generated/**"],
			"outputLogs": "new-only",
			"outputs": ["build/**", "dist/**", "out/**"]
		},
		"check-types": {
			"dependsOn": ["^export", "generate"],
			"inputs": ["src/**", "tsconfig*.json"],
			"outputLogs": "new-only"
		},
		"dev": {
			"cache": false,
			"dependsOn": ["^export", "generate"],
			"persistent": true
		},
		"export": {
			"dependsOn": ["^export", "generate"],
			"env": ["DATABASE_URL", "COMPANY_SLUG", "NODE_ENV"],
			"inputs": ["src/**", "!src/**/generated/**"],
			"outputLogs": "new-only",
			"outputs": ["out/**"],
			"cache": false
		},
		"frontend#build": {
			"cache": false,
			"dependsOn": ["^export", "generate"],
			"env": ["COMPANY_SLUG", "DATABASE_URL", "NODE_ENV", "VITE_API_URL", "VITE_APP_URL", "VITE_COMPANY_SLUG"],
			"inputs": ["src/**", "!src/**/generated/**"],
			"outputLogs": "new-only",
			"outputs": ["build/**", "dist/**", "out/**", ".next/**", "!.next/cache/**"]
		},
		"frontend#dev": {
			"cache": false,
			"dependsOn": ["^export", "generate"],
			"persistent": true,
			"env": ["COMPANY_SLUG", "DATABASE_URL", "NODE_ENV", "VITE_API_URL", "VITE_APP_URL", "VITE_COMPANY_SLUG"]
		},
		"frontend#generate": {
			"dependsOn": ["^export"],
			"inputs": ["kubb.config.ts"],
			"outputLogs": "new-only",
			"outputs": ["src/lib/api/generated/**"]
		},
		"frontend#inject": {
			"cache": false,
			"dependsOn": ["sql#export"],
			"env": ["COMPANY_SLUG", "DATABASE_URL", "NODE_ENV", "VITE_API_URL", "VITE_APP_URL", "VITE_COMPANY_SLUG"],
			"inputs": [".env*", "index.html", "scripts/inject.ts", "src-tauri/tauri.conf.json", "scripts/defaults/**", "scripts/branding-assets.ts", "scripts/branding-icons.ts"],
			"outputLogs": "new-only",
			"outputs": ["index.html", "public/apple-touch-icon.png", "public/branding.css", "public/favicon.png", "public/logo.*", "src/lib/branding.ts", "src-tauri/icons", "src-tauri/tauri.conf.json", "public/mobile-icon.*"]
		},
		"generate": {
			"dependsOn": ["^export"],
			"env": ["DATABASE_URL"],
			"inputs": ["src/**", "!src/generated/**"],
			"outputLogs": "new-only",
			"outputs": ["src/generated/**"]
		},
		"migrate:deploy": {
			"env": ["DATABASE_URL", "DATABASE_TEST_URL"],
			"inputs": ["src/migrations/**"],
			"outputLogs": "new-only"
		},
		"sql#export": {
			"dependsOn": ["^export", "generate"],
			"env": ["DATABASE_URL"],
			"inputs": ["src/**", "!src/**/generated/**"],
			"outputLogs": "new-only",
			"outputs": ["out/**"]
		},
		"test": {
			"dependsOn": ["test:e2e", "test:unit"]
		},
		"test:e2e": {
			"cache": false,
			"dependsOn": ["^export"],
			"env": ["DATABASE_TEST_URL", "DATABASE_URL"],
			"inputs": ["**/*.e2e.test.ts"]
		},
		"test:unit": {
			"dependsOn": ["^export"],
			"inputs": ["**/*.test.ts", "!**/*.e2e.test.ts"],
			"outputLogs": "new-only"
		},
		"backend#check-types": {
			"cache": false,
			"dependsOn": ["^export", "generate"],
			"env": ["COMPANY_SLUG", "DATABASE_URL", "NODE_ENV", "VITE_API_URL", "VITE_APP_URL", "VITE_COMPANY_SLUG"]
		},
		"frontend#check-types": {
			"cache": false,
			"dependsOn": ["^export", "generate"],
			"env": ["COMPANY_SLUG", "DATABASE_URL", "NODE_ENV", "VITE_API_URL", "VITE_APP_URL", "VITE_COMPANY_SLUG"]
		},
		"frontend#build:tauri": {
			"cache": false,
			"dependsOn": ["^export", "generate"],
			"env": ["COMPANY_SLUG", "DATABASE_URL", "NODE_ENV", "VITE_API_URL", "VITE_APP_URL", "VITE_COMPANY_SLUG"]
		},
		"frontend#dev:android": {
			"cache": false,
			"dependsOn": ["^export", "generate"],
			"env": ["COMPANY_SLUG", "DATABASE_URL", "NODE_ENV", "VITE_API_URL", "VITE_APP_URL", "VITE_COMPANY_SLUG"],
			"persistent": true
		},
		"frontend#dev:desktop": {
			"cache": false,
			"dependsOn": ["^export", "generate"],
			"env": ["COMPANY_SLUG", "DATABASE_URL", "NODE_ENV", "VITE_API_URL", "VITE_APP_URL", "VITE_COMPANY_SLUG"],
			"persistent": true
		},
		"frontend#dev:ios": {
			"cache": false,
			"dependsOn": ["^export", "generate"],
			"env": ["COMPANY_SLUG", "DATABASE_URL", "NODE_ENV", "VITE_API_URL", "VITE_APP_URL", "VITE_COMPANY_SLUG"],
			"persistent": true
		}
	}
}
