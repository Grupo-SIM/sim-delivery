/// Company catalog item. Unit/category-specific availability and price overrides are modeled
/// separately by UnitProduct (docs/05).
model Product {
    id                      String   @id @default(cuid())
    companyId               String
    title                   String
    slug                    String
    imageUrl                String   @default("")
    description             String   @default("")
    /// Base price in cents; unit associations may override it.
    basePriceCents          Int
    /// Optional percent override. Null means use the unit default cashback percentage.
    cashbackPercentOverride Float?
    /// Number of times this product has been ordered; used for "Os mais pedidos" strip (docs/05).
    popularity              Int      @default(0)
    createdAt               DateTime @default(now())
    updatedAt               DateTime @updatedAt

    company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
    categories   ProductCategory[]
    optionGroups OptionGroup[]
    reviews      ProductReview[]
    tags         ProductTag[]
    unitProducts UnitProduct[]
    recipeIngredients ProductRecipeIngredient[]

    @@index([companyId])
    @@unique([companyId, slug])
    @@map("product")
}

model ProductCategory {
    productId  String
    categoryId String
    createdAt  DateTime @default(now())

    product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
    category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

    @@id([productId, categoryId])
    @@index([categoryId])
    @@map("product_category")
}

model ProductTag {
    productId String
    tagId     String
    createdAt DateTime @default(now())

    product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
    tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

    @@id([productId, tagId])
    @@index([tagId])
    @@map("product_tag")
}
