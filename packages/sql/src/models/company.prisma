/// A tenant of the platform. Root scope of every business entity.
model Company {
    id         String   @id @default(cuid())
    name       String
    slug       String   @unique
    /// Per-company deployment configuration, consumed by static storefront builds.
    packageName String?  @unique
    siteUrl     String?
    apiUrl      String?
    /// Initial owner provisioning email; never a credential or an automatic ownership transfer.
    ownerEmail  String?
    /// Branding fields rendered in the store footer and app shell.
    logoUrl     String?
    /// Dedicated source for the mobile app icon. Falls back to logoUrl (with safe padding) when unset.
    mobileIconUrl String?
    /// Image used when a storefront unit has no listing image of its own.
    unitFallbackImageUrl String?
    /// Ordered wide artwork shown as a carousel above the storefront unit selection.
    welcomeEyebrow String?
    welcomeTitle String?
    welcomeTitleAccent String?
    welcomeDescription String?
    footerText  String?
    footerPaymentMethods String[] @default([])
    footerInstagramUrl String?
    footerFacebookUrl String?
    footerWhatsApp String?
    footerSupportEmail String?
    fontFamily  String?
    fontDisplay String?
    fontFamilyUrl String?
    fontDisplayUrl String?
    themeColors Json?
    defaultTheme String @default("light")
    allowThemeToggle Boolean @default(true)
    /// Per-company WhatsApp messages keyed by order status.
    orderStatusWhatsAppTemplates Json?
    orderStatusEmailTemplates    Json?
    /// Ordered receipt layout blocks configured by company managers.
    receiptTemplate Json?
    /// Marketing tracking IDs injected into the store at runtime.
    legalName String?
    address String?
    privacyContactEmail String?
    privacyContactPhone String?
    metaCapiToken String?
    marketingEvents MarketingEvent[]
    metaPixelId String?
    ga4Id       String?
    gtmId       String?
    orderBoardStartedAt DateTime?
    /// Legal and payout configuration for the SIM INT PAY merchant.
    cnpj String? @unique
    withdrawalMinimumCents Int?
    withdrawalPixKey String?
    simpayMerchantId String?
    createdAt   DateTime @default(now())
    updatedAt  DateTime @updatedAt

    categories Category[]
    coupons    Coupon[]
    customers  Customer[]
    deliveries Delivery[]
    orders     Order[]
    products   Product[]
    refunds    Refund[]
    productReviews ProductReview[]
    promotionalImages PromotionalImage[]
    reviews    Review[]
    tags       Tag[]
    units      Unit[]
    whatsAppConnection CompanyWhatsAppConnection?
    unitWhatsAppConnections UnitWhatsAppConnection[]
    whatsAppNotifications WhatsAppNotification[]
    users      User[]
    inventoryItems InventoryItem[]
    inventorySettings InventorySettings?
    withdrawals Withdrawal[]
    simpayIntegration CompanySimpayIntegration?
    feeOverrides CompanyFeeOverride[]

    @@map("company")
}

/// WAHA session used for login OTP and as the notification fallback for a company.
model CompanyWhatsAppConnection {
    id             String   @id @default(cuid())
    companyId      String   @unique
    sessionName    String   @unique
    connectedPhone String?
    lastStatus     String?
    lastError      String?
    lastSyncedAt   DateTime?
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt
    company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
    @@map("company_whatsapp_connection")
}
