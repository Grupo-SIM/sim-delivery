{
	"name": "backend",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "bun ./scripts/build.ts",
		"check-types": "bun run inject && tsc --noEmit",
		"dev": "bun run inject && bun --watch src/main.ts",
		"export": "bun run inject && bun ./src/generateOpenApi.ts",
		"inject": "bun ./scripts/inject.ts",
		"reconcile:simpay-payments": "bun ./scripts/reconcile-simpay-payments.ts",
		"sync:additive-fees": "bun ./scripts/sync-additive-fees-to-simintpay.ts",
		"start": "NODE_ENV=production bun dist/main.js",
		"test:unit": "bun test --coverage"
	},
	"dependencies": {
		"@elysiajs/openapi": "^1.4.15",
		"@elysiajs/static": "^1.4.10",
		"@hyoretsu/providers": "^2.1.2",
		"@hyoretsu/utils": "^1.18.1",
		"@react-email/components": "^1.0.12",
		"@sinclair/typebox": "^0.34.52",
		"@types/nodemailer": "^8.0.1",
		"better-auth": "^1.6.23",
		"elysia": "^1.4.29",
		"elysia-ip": "^1.1.0",
		"es-toolkit": "^1.49.0",
		"http-status-codes": "^2.3.0",
		"ky": "^2.0.2",
		"nodemailer": "^9.0.3",
		"nodemailer-sendgrid": "^1.0.3",
		"permix": "^3.8.1",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"sql": "workspace:*",
		"write-excel-file": "^4.1.1"
	},
	"devDependencies": {
		"@elysiajs/cors": "^1.4.2",
		"@hyoretsu/configs": "^1.2.37",
		"@types/bun": "^1.3.14",
		"@types/http-status-codes": "^1.2.0",
		"@types/node": "^26.1.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"typescript": "^6.0.3"
	}
}
