{
	"$schema": "https://turborepo.dev/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^export", "generate"],
			"inputs": ["src/**", "!src/**/generated/**"],
			"outputLogs": "new-only",
			"outputs": ["build/**", "dist/**", "out/**"]
		},
		"check-types": {
			"dependsOn": ["^export", "generate"],
			"inputs": ["src/**", "tsconfig*.json"],
			"outputLogs": "new-only"
		},
		"dev": {
			"cache": false,
			"dependsOn": ["^export", "generate"],
			"persistent": true
		},
		"export": {
			"dependsOn": ["^export", "generate"],
			"env": ["DATABASE_URL"],
			"inputs": ["src/**", "!src/**/generated/**"],
			"outputLogs": "new-only",
			"outputs": ["out/**"]
		},
		"frontend#build": {
			"dependsOn": ["^export", "generate", "inject"],
			"inputs": ["src/**", "!src/**/generated/**"],
			"outputLogs": "new-only",
			"outputs": ["build/**", "dist/**", "out/**", ".next/**", "!.next/cache/**"]
		},
		"frontend#dev": {
			"cache": false,
			"dependsOn": ["^export", "generate", "inject"],
			"persistent": true
		},
		"frontend#generate": {
			"dependsOn": ["^export"],
			"inputs": ["kubb.config.ts"],
			"outputLogs": "new-only",
			"outputs": ["src/lib/api/generated/**"]
		},
		"frontend#inject": {
			"env": ["VITE_API_URL", "VITE_APP_URL", "VITE_COMPANY_SLUG"],
			"inputs": ["scripts/inject.ts", ".env*"],
			"outputLogs": "new-only",
			"outputs": [
				"public/apple-touch-icon.png",
				"public/branding.css",
				"public/favicon.png",
				"public/logo.*",
				"src/lib/branding.ts",
				"src-tauri/icons",
				"src-tauri/tauri.conf.json"
			]
		},
		"generate": {
			"dependsOn": ["^export"],
			"env": ["DATABASE_URL"],
			"inputs": ["src/**", "!src/generated/**"],
			"outputLogs": "new-only",
			"outputs": ["src/generated/**"]
		},
		"migrate:deploy": {
			"env": ["DATABASE_URL", "DATABASE_TEST_URL"],
			"inputs": ["src/migrations/**"],
			"outputLogs": "new-only"
		},
		"test": {
			"dependsOn": ["test:e2e", "test:unit"]
		},
		"test:e2e": {
			"cache": false,
			"dependsOn": ["^export"],
			"env": ["DATABASE_TEST_URL", "DATABASE_URL"],
			"inputs": ["**/*.e2e.test.ts"]
		},
		"test:unit": {
			"dependsOn": ["^export"],
			"inputs": ["**/*.test.ts", "!**/*.e2e.test.ts"],
			"outputLogs": "new-only"
		}
	}
}
