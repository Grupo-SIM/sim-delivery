/// A customer order placed at a unit. Status follows the lifecycle defined in docs/06.
/// `subtotal`, `deliveryFee` and `total` are integer cents (never floats).
model Order {
    id             String   @id @default(cuid())
    companyId      String
    unitId         String
    customerId     String
    preparedById   String?
    addressId      String?
    couponId              String?
    /// One of: awaiting_payment | recebido | em_preparo | pronto | saiu_para_entrega | entregue | retirado | cancelado
    status                String   @default("awaiting_payment")
    subtotal              Int
    deliveryFee           Int      @default(0)
    discountCents         Int      @default(0)
    cashbackCentsRedeemed Int      @default(0)
    loyaltyPointsRedeemed Int      @default(0)
    total                 Int
    /// "delivery" or "pickup"
    deliveryMethod String
    cancelReason   String?
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt

    company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
    unit            Unit             @relation(fields: [unitId], references: [id])
    customer        Customer         @relation(fields: [customerId], references: [id])
    preparedBy      User?            @relation("PreparedOrders", fields: [preparedById], references: [id], onDelete: SetNull)
    address         Address?         @relation(fields: [addressId], references: [id])
    coupon          Coupon?          @relation(fields: [couponId], references: [id])
    cashbackLedger  CashbackLedger[]
    delivery        Delivery?
    loyaltyLedger   LoyaltyLedger[]
    items           OrderItem[]
    payment         Payment?
    productReviews  ProductReview[]
    review          Review?
    statusEvents    OrderStatusEvent[]

    @@index([companyId, status])
    @@index([customerId])
    @@index([preparedById])
    @@map("order")
}

/// A single line item in an order. Price and name are snapshotted at creation time.
model OrderStatusEvent {
    id        String   @id @default(cuid())
    orderId   String
    status    String
    createdAt DateTime @default(now())

    order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

    @@index([orderId, createdAt])
    @@map("order_status_event")
}

model OrderItem {
    id          String  @id @default(cuid())
    orderId     String
    productId   String
    productName String
    unitPrice   Int
    quantity    Int
    note        String?
    total       Int

    order           Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
    optionSnapshots OrderItemOption[]

    @@index([orderId])
    @@map("order_item")
}
