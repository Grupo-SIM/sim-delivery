/// Company catalog item. Unit/category-specific availability and price overrides are modeled
/// separately by UnitProduct (docs/05).
model Product {
    id                      String   @id @default(cuid())
    companyId               String
    title                   String
    slug                    String
    imageUrl                String   @default("")
    description             String   @default("")
    /// Base price in cents; unit associations may override it.
    basePriceCents          Int
    /// Optional percent override. Null means use the unit default cashback percentage.
    cashbackPercentOverride Float?
    /// Number of times this product has been ordered; used for "Os mais pedidos" strip (docs/05).
    popularity              Int      @default(0)
    createdAt               DateTime @default(now())
    updatedAt               DateTime @updatedAt

    company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
    optionGroups OptionGroup[]
    unitProducts UnitProduct[]

    @@index([companyId])
    @@unique([companyId, slug])
    @@map("product")
}
