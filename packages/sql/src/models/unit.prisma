/// A physical store of a company. A company has 1..N units, each with its own
/// address, hours, fees and payment/delivery options (see docs/04).
model Unit {
    id           String   @id @default(cuid())
    companyId    String
    name         String
    slug         String
    phone        String?
    // Address (deduced from CEP on the client app; see docs/08).
    zipCode      String?
    addressLine  String?
    number       String?
    complement   String?
    neighborhood String?
    city         String?
    state        String?
    reference    String?
    latitude     Float?
    longitude    Float?
    // Fulfilment: which methods this unit offers (delivery | pickup).
    deliveryMethods String[] @default(["delivery"])
    /// Delivery fee in cents (flat, MVP). See docs/09 for zone/distance evolution.
    deliveryFee     Int      @default(0)
    /// Whether the flat `deliveryFee` is used as a fallback when the customer's address
    /// falls outside every `deliveryZones` radius (or the unit has none configured).
    deliveryFeeFallbackEnabled Boolean @default(true)
    /// Default cashback percentage granted on orders from this unit (docs/09).
    cashbackPercent Float    @default(0)
    /// Loyalty points rate: points earned per 100 cents spent on this unit (0 = disabled).
    loyaltyPointsRate Float  @default(0)
    /// Manual open/closed override. Null = follow the weekly hours (docs/04).
    isOpenManual       Boolean?
    /// Minimum order subtotal in cents for delivery orders (0 = no minimum).
    minOrderCents      Int      @default(0)
    /// Estimated preparation time range displayed to the customer (null = not configured).
    prepTimeMinMinutes Int?
    prepTimeMaxMinutes Int?
    createdAt          DateTime @default(now())
    updatedAt       DateTime @updatedAt

    company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
    coupons       Coupon[]
    deliveries    Delivery[]
    deliveryZones DeliveryZone[]
    hours         UnitHours[]
    products      UnitProduct[]
    orders        Order[]

    @@index([companyId])
    @@unique([companyId, slug])
    @@map("unit")
}
