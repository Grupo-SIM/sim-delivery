/// A tenant of the platform. Root scope of every business entity.
model Company {
    id         String   @id @default(cuid())
    name       String
    slug       String   @unique
    /// Per-company deployment configuration, consumed by static storefront builds.
    packageName String?  @unique
    siteUrl     String?
    apiUrl      String?
    /// Branding fields rendered in the store footer and app shell.
    logoUrl     String?
    bannerUrl   String?
    footerText  String?
    fontFamily  String?
    fontDisplay String?
    fontFamilyUrl String?
    fontDisplayUrl String?
    themeColors Json?
    /// Marketing tracking IDs injected into the store at runtime.
    metaPixelId String?
    ga4Id       String?
    gtmId       String?
    createdAt   DateTime @default(now())
    updatedAt  DateTime @updatedAt

    categories Category[]
    coupons    Coupon[]
    customers  Customer[]
    deliveries Delivery[]
    orders     Order[]
    products   Product[]
    reviews    Review[]
    tags       Tag[]
    units      Unit[]
    users      User[]

    @@map("company")
}
