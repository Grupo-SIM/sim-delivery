/// Consumer end-user of a company's storefront app. Created automatically at the first
/// checkout (docs/07, docs/08). Strictly scoped by `companyId`; one record per company
/// for the Better Auth `User` that owns the login, independently of their staff role.
model Customer {
    id        String   @id @default(cuid())
    companyId String
    userId    String
    cpf       String?
    phone     String?
    /// Customer-selected channels for transactional order-status notifications.
    notificationEmail    Boolean @default(true)
    notificationWhatsApp Boolean @default(true)
    /// DOM Pagamentos customer id, created lazily on the first card payment.
    domId     String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    company          Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
    user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
    addresses        Address[]
    cashbackLedger   CashbackLedger[]
    loyaltyLedger    LoyaltyLedger[]
    orders           Order[]
    productReviews   ProductReview[]
    reviews          Review[]
    savedCards       SavedCard[]

    @@unique([companyId, userId])
    @@unique([companyId, cpf])
    @@index([companyId])
    @@map("customer")
}
