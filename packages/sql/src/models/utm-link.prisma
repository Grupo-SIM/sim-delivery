/// Tracked short link `/utm/<path>` that redirects to the storefront with fixed UTMs. `path` has 1..6
/// lowercase segments joined by "/". Managed by superAdmin only; resolved publicly by path. Global (not per company).
model UtmLink {
    id        String   @id @default(cuid())
    path      String
    source    String?
    medium    String?
    campaign  String?
    content   String?
    /// Optional redirect destination: absolute http(s) URL or a "/path" of the storefront. Empty = home.
    url       String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([path])
    @@map("utm_link")
}
