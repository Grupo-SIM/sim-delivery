/// Groups products in the menu (e.g. "Cheese bread", "Promotions"). Company-scoped; a category
/// is opted into each unit's menu via UnitCategory (which also holds that unit's ordering). A
/// product may also be category-less (listed loose).
model Category {
    id        String   @id @default(cuid())
    companyId String
    name      String
    imageUrl  String   @default("")
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
    unitProducts   UnitProduct[]
    unitCategories UnitCategory[]

    @@index([companyId])
    @@map("category")
}
