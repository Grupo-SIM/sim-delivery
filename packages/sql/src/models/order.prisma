/// A customer order placed at a unit. Status follows the lifecycle defined in docs/06.
/// `subtotal`, `deliveryFee` and `total` are integer cents (never floats).
model Order {
    id             String   @id @default(cuid())
    displayNumber  Int      @unique @default(autoincrement())
    companyId      String
    unitId         String
    customerId     String
    /// Client-generated UUID that makes checkout retries return this same order.
    marketingAttribution Json?
    marketingEvents MarketingEvent[]
    idempotencyKey String?
    preparedById   String?
    addressId      String?
    couponId              String?
    /// One of: awaiting_payment | recebido | em_preparo | pronto | saiu_para_entrega | problema | entregue | retirado | cancelado
    status                String   @default("awaiting_payment")
    subtotal              Int
    deliveryFee           Int      @default(0)
    discountCents         Int      @default(0)
    cashbackCentsRedeemed Int      @default(0)
    loyaltyPointsRedeemed Int      @default(0)
    /// Platform surcharges charged on top of merchant prices.
    feeTotalCents         Int      @default(0)
    total                 Int
    /// "delivery" or "pickup"
    deliveryMethod String
    cancelReason   String?
    problemReason  String?
    /// Absolute deadline for completing the current operational phase.
    estimatedStatusCompletionAt DateTime?
    /// Cents refunded so far across all `Refund` records for this order's payment.
    refundedCents  Int      @default(0)
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt

    company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
    unit            Unit             @relation(fields: [unitId], references: [id])
    customer        Customer         @relation(fields: [customerId], references: [id])
    preparedBy      User?            @relation("PreparedOrders", fields: [preparedById], references: [id], onDelete: SetNull)
    address         Address?         @relation(fields: [addressId], references: [id])
    coupon          Coupon?          @relation(fields: [couponId], references: [id])
    cashbackLedger  CashbackLedger[]
    delivery        Delivery?
    loyaltyLedger   LoyaltyLedger[]
    items           OrderItem[]
    payment         Payment?
    productReviews  ProductReview[]
    refunds         Refund[]
    review          Review?
    statusEvents    OrderStatusEvent[]
    inventoryMovements InventoryMovement[]
    inventoryReservations InventoryReservation[]
    whatsAppNotifications WhatsAppNotification[]
    feeSnapshots    OrderFeeSnapshot[]

    @@index([companyId, status])
    @@index([companyId, status, createdAt])
    @@index([customerId])
    @@index([preparedById])
    @@unique([customerId, idempotencyKey])
    @@map("order")
}

/// Durable outbox entry for transactional WhatsApp order notifications.
model WhatsAppNotification {
    id            String    @id @default(cuid())
    orderId       String?
    companyId     String?
    unitId        String?
    /// Unit session selected when the notification entered the outbox. Null uses the global session.
    sessionName   String?
    recipient     String
    message       String
    /// Frozen image/PDF metadata delivered with this notification.
    attachments   Json      @default("[]")
    orderStatus   String
    deduplicationKey String  @unique
    /// pending | processing | sent | failed
    status        String    @default("pending")
    attempts      Int       @default(0)
    nextAttemptAt DateTime  @default(now())
    leaseUntil    DateTime?
    lastError     String?
    sentAt        DateTime?
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt

    order   Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
    company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
    unit    Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)

    @@index([status, nextAttemptAt])
    @@index([status, leaseUntil])
    @@index([orderId])
    @@index([companyId, unitId])
    @@map("whatsapp_notification")
}

/// A single line item in an order. Price and name are snapshotted at creation time.
model OrderStatusEvent {
    id        String   @id @default(cuid())
    orderId   String
    status    String
    createdAt DateTime @default(now())

    order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

    @@index([orderId, createdAt])
    @@map("order_status_event")
}

model OrderItem {
    id          String  @id @default(cuid())
    orderId     String
    productId   String
    unitProductId String?
    productName String
    unitPrice   Int
    quantity    Int
    note        String?
    total       Int
    /// Cost currently incurred: reduced when a reservation is released on cancel, restored
    /// on reopen, and left untouched for reservations already `consumed` (real waste).
    costCents   Int?
    /// Immutable snapshot of `costCents` at order creation — the cost of the sale itself.
    costCentsAtSale Int?
    /// Set the first time `costCents` is adjusted by a cancel/reopen transition.
    costRecalculatedAt DateTime?
    netRevenueCents Int?

    order           Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
    optionSnapshots OrderItemOption[]
    inventoryReservations InventoryReservation[]
    feeSnapshots          OrderItemFeeSnapshot[]

    @@index([orderId])
    @@map("order_item")
}
