/// Explicit unit assignments for unit-scoped staff. Every non-owner staff member
/// requires at least one assignment; no assignment ever means company-wide access.
model StaffUnit {
    userId String
    unitId String

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
    unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

    @@id([userId, unitId])
    @@index([unitId])
    @@map("staff_unit")
}
