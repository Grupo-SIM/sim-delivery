{
	"$schema": "../node_modules/@biomejs/biome/configuration_schema.json",
	"extends": ["@hyoretsu/configs/biome-react"],
	"linter": {
		"rules": {
			"a11y": {
				"noLabelWithoutControl": {
					"level": "on",
					"options": {
						"inputComponents": [
							"Checkbox",
							"CurrencyInput",
							"Input",
							"MaskedInput",
							"MediaUrlInput",
							"NumericInput",
							"RgbInput",
							"Select",
							"UnitHoursInput"
						]
					}
				}
			}
		}
	},
	"root": false
}
